{
  "name": "nexus-studio",
  "version": "1.0.1",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "Linzedong-16",
  "license": "MIT",
  "homepage": "https://github.com/Linzedong-16/Nexus-Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Linzedong-16/Nexus-Studio.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "prestart": "node -e \"if(process.platform==='win32')require('child_process').execSync('chcp 65001',{stdio:'ignore'})\"",
    "start": "electron-vite preview",
    "predev": "node -e \"if(process.platform==='win32')require('child_process').execSync('chcp 65001',{stdio:'ignore'})\"",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "dotenv": "^16.6.1",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "mysql2": "^3.15.3",
    "node-cron": "^4.6.0",
    "node-sql-parser": "^5.4.0",
    "openai": "^4.104.0",
    "pg": "^8.23.0",
    "sql-formatter": "^15.8.2",
    "uuid": "^14.0.1",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/node": "^22.19.1",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "elkjs": "^0.12.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "framer-motion": "^13.1.0",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.30.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "0.56.0",
    "papaparse": "^5.6.0",
    "prettier": "^3.7.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "^8.3.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "zustand": "^5.0.14"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
