# Nexus Studio - Code 模式 Agent 配置
# 复制本文件为 .env（同目录），并填入真实的 DeepSeek API 密钥后重启应用即可生效
# .env 已被 .gitignore 忽略，不会被提交到版本库（FR-008）

# DeepSeek API 密钥（必填）。留空时 Agent 会返回"未配置"提示，其余功能不受影响
DEEPSEEK_API_KEY=

# DeepSeek API 基础地址（可选，默认使用官方地址）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型名称（可选，默认 deepseek-v4-flash）
DEEPSEEK_MODEL=deepseek-v4-flash

# ReAct 循环最大思考-行动轮次，达到该轮次仍未得出结论则判定失败（可选，默认 8）
AGENT_MAX_ITERATIONS=8

# 单次 DeepSeek 请求的超时时间，单位毫秒（可选，默认 60000）
AGENT_REQUEST_TIMEOUT_MS=60000
